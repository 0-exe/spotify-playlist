# Spotify API Credentials
# Erstellen unter: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# Eigene feste IP im Heimnetzwerk:
SPOTIPY_REDIRECT_URI=http://192.168.178.199:8000/callback

# Google Gemini API Key (kann auch später im Web-UI eingetragen werden)
# Erstellen unter: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Netzwerkkarte deines Hosts (Standard eth0, bei manchen VMs ens18)
PARENT_INTERFACE=eth0
APP_PORT=8000
